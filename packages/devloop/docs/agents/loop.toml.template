# loop.toml — TEMPLATE. Copy to your repo's docs/agents/loop.toml and edit the
# lines marked `← EDIT`. Everything else is a working default; delete any knob
# you don't want to override and the rail supplies the same value from
# devloop/cli.py's DEFAULT_CONFIG.
#
# How the copy takes effect: the rail searches upward from the cwd (the working
# directory) for `docs/agents/loop.toml`, stopping at the repo root (`.git`), and
# falls back to the copy shipped with the package. So the gate pipeline belongs
# to the repo you are working in — no flag to pass, and no editing an installed
# package. `devloop config` prints what actually resolved; if it is not yours,
# check the path and the directory you ran from.
#
# Read by the `devloop` rail (`uv run devloop config`) and by the /issue-loop
# command (orchestration). Per-run posture belongs on
# the command line, not in edits to this file: `--set` and its sugar are
# issue-loop.command.md §0's.

[loop]
max_issues_per_run = 3   # token guardrail: issues processed per invocation
max_fix_rounds = 2       # implement→gates→fix iterations before routing to human; never extended mid-run
training_mode = true     # pause for human approval before push/PR; flip when trusted
branch_prefix = "loop/issue-"
require_green_baseline = true   # red suite on main → refuse to implement
run_mode = "pass"          # pass | exhaust (issue-loop.command.md §0)
delivery = "pr-per-issue"  # pr-per-issue | stacked (issue-loop.command.md §0)

[tdd]
# auto: TDD is ENFORCED iff the per-run baseline probe is green.
# always / never override the probe.
mode = "auto"

[labels]
# ← EDIT if your tracker uses different vocabulary (see triage-labels.md).
runnable = "ready-for-agent"
claimed = "agent-claimed"
on_gate_failure = "ready-for-human"

# ── Risk-lane triage ──────────────────────────────────────────────────────
# After all gates pass, the rail classifies the shipped PR yellow (a human
# skims) or red (a human must look) so review effort lands where it matters.
# The rail CLASSIFIES; the orchestrator applies the label. Red wins.
[triage]
# ← EDIT: sensitive paths are always red, whatever the size or judge verdict.
# Empty means "no path is sensitive here" — an inherited list from another
# repo's layout classifies the wrong files, so this ships empty on purpose.
# Three pattern forms: dir prefix (trailing '/'), bare basename (matches at any
# depth), glob (*/?/[ — matched against the basename). Typical picks: your
# public API surface, auth/crypto, migrations, this gate pipeline.
sensitive_paths = []
# ← EDIT: watched paths name the file in the yellow lane's reasons — a human
# skims, the gate never fails. docs/agents/ ships live, not commented: it is
# devloop's own convention (the loop.toml and constitution overlay live there
# in every adopting repo), and the constitution's amendment path relies on a
# human seeing the diff.
watched_paths = ["docs/agents/"]
red_diff_lines = 800             # "big diff" → red (a signal for the human lane, never a block)

# ── Dispatch ──────────────────────────────────────────────────────────────
# Which agent runs each role. Run posture, so every key takes --set for one
# run. A role IS its entry: implementer and judge always resolve,
# and one more [dispatch.<role>] table declares one more role (plus its
# section in issue-loop.command.md); a key outside the six is refused by
# name. Absent keys mean the Agent tool in the orchestrator's own
# session and model, with no argv tail. The rail checks shape only — it never
# validates a harness or model name, and it never imports a harness profile:
# `args` is the literal argv tail the harness binary takes, written by you.
[dispatch.implementer]
posture = "writer"          # writer: persona + standing orders; reader: neither
transport = "agent-tool"    # agent-tool | herdr
# harness = "claude"        # herdr --kind value; absent = the orchestrator's own harness
# model = "opus"            # recorded in the stage record; passed via args
# effort = "high"
# args = ["--model", "opus"]  # literal argv tail after `--`; the host writes it

[dispatch.judge]
# reader: the per-slice judge, its pack the touched modules in full.
# shape: the stack-tip pass over every touched module and its edges
# (`devloop pack <N...> --role judge --posture shape`).
posture = ["reader", "shape"]
transport = "agent-tool"

# On herdr the agent runs in its own terminal, so nobody answers its approval
# prompts: an unanswered prompt settles as `blocked` and routes the issue to
# human. `args` must settle that per harness. Tails that run unattended
# (the orchestrator appends `--add-dir <return-dir>` per run):
#   claude: args = ["--permission-mode", "auto"]
#   codex:  args = ["-s", "workspace-write", "-a", "never"]
# Codex also blocks at startup on its folder-trust prompt, keyed on the
# repository root: trust the repo once in ~/.codex/config.toml, or pass
# "-c", 'projects."<repo-root>".trust_level="trusted"' in the tail.
# Try a role on herdr for one run with
# `--set dispatch.judge.transport=herdr --set dispatch.judge.harness=codex`.
# [dispatch.judge]
# posture = ["reader", "shape"]
# transport = "herdr"
# harness = "codex"
# args = ["-s", "workspace-write", "-a", "never"]

# ── Gate pipeline ─────────────────────────────────────────────────────────
# Ordered, and the order is the contract: the deterministic guards run first,
# then the one judge. kinds: command | diff (deterministic, run by the rail)
# — judge (LLM-judged, run by the command in a fresh subagent context).
# `devloop check --issue <N>` runs every command gate, then the issue's
# `verify:` lines, as one result list. Another command/diff gate is
# config-only; a new *kind* needs a DETERMINISTIC entry in devloop/gates.py or
# a section in the /issue-loop command. A gate carries only the keys its kind
# reads; anything else is refused by name.

[[gates]]
id = "diff-guard"
kind = "diff"
required = true
# ← EDIT: paths an agent must never touch. Same three pattern forms as
# [triage].sensitive_paths (both go through devloop/paths.py). CI config is
# here because a loop that can edit its own gates has no gates. This is a
# forbidden-paths check only — there is no line cap.
forbidden_paths = [".github/workflows/"]

[[gates]]
id = "tests"
kind = "command"
required = true
cmd = "pytest -q"   # ← EDIT: your repo's test command. Pass = exit 0.
timeout_sec = 1200

# The one judgment stage: a fresh judge returns criteria[] verdicts against
# the issue's acceptance criteria plus advisory findings[]. Fails iff a
# criterion is not-met; findings never block.
[[gates]]
id = "judge"
kind = "judge"
required = true
